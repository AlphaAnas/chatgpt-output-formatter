certs/
.office-addin-dev-certs/
*.manifest.xml.local

# Automatically generated backup manifest from validation tools
manifest.xml.bak
manifest.json.bak

# Debugging and sideloading cache states
.webpack/
.parcel-cache/
.vite/

# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key

